# Standard L4Re Search Path
modaddr 0x01100000

default-kernel fiasco -serial_esc
default-bootstrap bootstrap

entry yocto-vm
roottask moe rom/yocto-vm.cfg
module l4re
module ned
module cons
module io
module emmc-drv
module uvmm
module yocto-vm.cfg
module io.cfg
module[fname=virt.dtb] dtb/yocto-guest.dtb

# Ensure path to your actual Yocto kernel binary is correct
module[fname=linux.bin] /home/admin1/yocto-rcar/build_h3ulcb/build_mmp/tmp/deploy/images/h3ulcb/Image

